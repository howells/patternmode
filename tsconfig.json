{
  "extends": "./packages/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@patternmode/ui/*": ["./packages/ui/src/*"],
      "@patternmode/ui": ["./packages/ui/src/index.ts"],
      "@patternmode/eslint-config/*": ["./packages/eslint-config/*"],
      "@patternmode/eslint-config": ["./packages/eslint-config/index.mjs"]
    },
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*",
    "apps/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/tests/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/dist/**",
    "**/.next/**",
    "**/build/**"
  ]
}
