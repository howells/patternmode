{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "concurrency": "15",
  "globalDependencies": [".env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env.local"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test", "typecheck"],
      "inputs": ["src/**", "tests/**", "**/*.test.*", "**/*.spec.*", "vitest.config.*", "package.json"]
    },
    "test:ui": {
      "dependsOn": ["^test:ui"],
      "cache": false,
      "persistent": true
    },
    "test:run": {
      "dependsOn": ["^test:run", "typecheck"],
      "inputs": ["src/**", "tests/**", "**/*.test.*", "**/*.spec.*", "vitest.config.*", "package.json"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["src/**", "tests/**", "**/*.spec.*", "playwright.config.*", "package.json"]
    },
    "test:generate": {
      "dependsOn": ["^test:generate"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
