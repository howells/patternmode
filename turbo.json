{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"globalDependencies": ["**/.env", "**/.env.local"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"dependsOn": ["^build"],
			"with": [
				"@howells/stacksheet#dev",
				"@howells/aperto#dev",
				"@howells/deck#dev",
				"@howells/button#dev"
			],
			"cache": false,
			"persistent": true
		},
		"lint:check": {},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^build"]
		}
	}
}
