{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "concurrency": "15",
  "globalDependencies": [".env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.local",
        "src/styles/**/*.css",
        "packages/ui/src/styles/**/*.css"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test", "typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "**/*.test.*",
        "vitest.config.*",
        "package.json"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": [
        "src/**",
        "tests/**",
        "**/*.test.*",
        "playwright.config.*",
        "package.json"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
