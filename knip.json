{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": ["turbo.json"],
      "project": [
        "*.{js,ts,tsx,mjs}",
        "!node_modules/**",
        "!.turbo/**",
        "!test-results/**"
      ]
    },
    "apps/web": {
      "entry": [
        "src/app/**/page.tsx",
        "src/app/api/**/*.ts",
        "tailwind.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "tailwind.config.ts",
        "next.config.ts",
        "eslint.config.mjs",
        "postcss.config.mjs"
      ]
    },
    
    "packages/tsconfig": {
      "entry": ["base.json"],
      "project": ["*.json"]
    }
  },
  "ignoreDependencies": ["eslint", "eslint-config-next", "playwright"],
  "ignoreBinaries": ["tsx"],
  "ignore": [
    "**/*.d.ts",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/test-results/**",
    "**/.next/**",
    "**/tsconfig.tsbuildinfo",
    "**/playwright/**",
    "**/*.playwright.test.tsx",
    "**/playwright/index.ts"
  ]
}
