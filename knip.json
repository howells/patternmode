{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "analyze-missing-props.ts",
        "check-icon-size.js",
        "icon-check.js",
        "fix-missing-jsdoc.js",
        "turbo.json"
      ],
      "project": [
        "*.{js,ts,tsx,mjs}",
        "!node_modules/**",
        "!.turbo/**",
        "!test-results/**"
      ]
    },
    "apps/web": {
      "entry": [
        "src/app/**/page.tsx",
        "src/app/api/**/*.ts",
        "tailwind.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "tailwind.config.ts",
        "next.config.ts",
        "eslint.config.mjs",
        "postcss.config.mjs"
      ]
    },
    "packages/ui": {
      "entry": [
        "debug-*.js",
        "scripts/**/*.{ts,js}",
        "tests/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{ts,js}",
        "tests/**/*.{ts,tsx}",
        "debug-*.js",
        "vitest.config.ts"
      ]
    },
    "packages/eslint-config": {
      "entry": ["rules/**/*.mjs"],
      "project": ["**/*.{js,mjs}"]
    },
    "packages/tsconfig": {
      "entry": ["base.json"],
      "project": ["*.json"]
    }
  },
  "ignoreDependencies": [
    "eslint",
    "eslint-config-next",
    "playwright"
  ],
  "ignoreBinaries": [
    "tsx"
  ],
  "ignore": [
    "**/*.d.ts",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/test-results/**",
    "**/.next/**",
    "**/tsconfig.tsbuildinfo"
  ]
}
