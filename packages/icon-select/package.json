{
  "name": "@patternmode/icon-select",
  "version": "0.1.0",
  "description": "High-performance icon picker using static Lucide registry and virtualized combobox",
  "author": {
    "name": "Daniel Howells",
    "email": "daniel@howellsstudio.com",
    "url": "https://github.com/howells"
  },
  "type": "module",
  "license": "MIT",
  "homepage": "https://patternmode.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/howells/patternmode.git",
    "directory": "packages/icon-select"
  },
  "bugs": {
    "url": "https://github.com/howells/patternmode/issues"
  },
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./component": {
      "types": "./src/components/icon-select.tsx",
      "import": "./src/components/icon-select.tsx",
      "default": "./src/components/icon-select.tsx"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./preview": {
      "types": "./src/preview.tsx",
      "import": "./src/preview.tsx",
      "default": "./src/preview.tsx"
    },
    "./examples": {
      "types": "./src/examples.tsx",
      "import": "./src/examples.tsx",
      "default": "./src/examples.tsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap --noEmit false --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --write"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-beta.3",
    "@patternmode/combobox": "workspace:*",
    "@patternmode/config": "workspace:*",
    "@patternmode/constants": "workspace:*",
    "@patternmode/icons": "workspace:*",
    "lucide-react": "^0.544.0"
  },
  "devDependencies": {
    "@patternmode/tsconfig": "workspace:*",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
