{
  "name": "@patternmode/eslint-config",
  "version": "0.1.0",
  "description": "ESLint configuration for PatternMode monorepo",
  "type": "module",
  "main": "index.cjs",
  "module": "index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs"
    }
  },
  "files": [
    "*.js",
    "*.cjs"
  ],
  "dependencies": {
    "@antfu/eslint-config": "^5.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint-react/eslint-plugin": "^1.21.0",
    "@next/eslint-plugin-next": "^15.1.0",
    "eslint-config-turbo": "^2.3.3",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "typescript": "^5.0.0"
  }
}