{
  "name": "@patternmode/toggle-group",
  "version": "0.1.0",
  "description": "Toggle group component for selecting one or many options",
  "type": "module",
  "license": "MIT",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./preview": {
      "types": "./src/preview.tsx",
      "import": "./src/preview.tsx",
      "default": "./src/preview.tsx"
    },
    "./examples": {
      "types": "./src/examples.tsx",
      "import": "./src/examples.tsx",
      "default": "./src/examples.tsx"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap --noEmit false --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --write"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@patternmode/utils": "workspace:*",
    "@patternmode/button": "workspace:*",
    "@patternmode/constants": "workspace:*",
    "@patternmode/icon": "workspace:*",
    "@base-ui-components/react": "^1.0.0-beta.2",
    "lucide-react": ">=0.525.0 <1",
    "tailwind-variants": "^3.1.0",
    "@patternmode/config": "workspace:*"
  },
  "devDependencies": {
    "@patternmode/tsconfig": "workspace:*"
  }
}
