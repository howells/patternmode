{
  "name": "@patternmode/alert-dialog",
  "version": "0.1.0",
  "description": "Alert dialog for critical confirmations",
  "type": "module",
  "license": "MIT",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./component": {
      "types": "./src/component.tsx",
      "import": "./src/component.tsx",
      "default": "./src/component.tsx"
    },
    "./root": {
      "types": "./src/components/alert-dialog-root.tsx",
      "import": "./src/components/alert-dialog-root.tsx",
      "default": "./src/components/alert-dialog-root.tsx"
    },
    "./trigger": {
      "types": "./src/components/alert-dialog-trigger.tsx",
      "import": "./src/components/alert-dialog-trigger.tsx",
      "default": "./src/components/alert-dialog-trigger.tsx"
    },
    "./portal": {
      "types": "./src/components/alert-dialog-portal.tsx",
      "import": "./src/components/alert-dialog-portal.tsx",
      "default": "./src/components/alert-dialog-portal.tsx"
    },
    "./backdrop": {
      "types": "./src/components/alert-dialog-backdrop.tsx",
      "import": "./src/components/alert-dialog-backdrop.tsx",
      "default": "./src/components/alert-dialog-backdrop.tsx"
    },
    "./content": {
      "types": "./src/components/alert-dialog-content.tsx",
      "import": "./src/components/alert-dialog-content.tsx",
      "default": "./src/components/alert-dialog-content.tsx"
    },
    "./header": {
      "types": "./src/components/alert-dialog-header.tsx",
      "import": "./src/components/alert-dialog-header.tsx",
      "default": "./src/components/alert-dialog-header.tsx"
    },
    "./footer": {
      "types": "./src/components/alert-dialog-footer.tsx",
      "import": "./src/components/alert-dialog-footer.tsx",
      "default": "./src/components/alert-dialog-footer.tsx"
    },
    "./title": {
      "types": "./src/components/alert-dialog-title.tsx",
      "import": "./src/components/alert-dialog-title.tsx",
      "default": "./src/components/alert-dialog-title.tsx"
    },
    "./description": {
      "types": "./src/components/alert-dialog-description.tsx",
      "import": "./src/components/alert-dialog-description.tsx",
      "default": "./src/components/alert-dialog-description.tsx"
    },
    "./action": {
      "types": "./src/components/alert-dialog-action.tsx",
      "import": "./src/components/alert-dialog-action.tsx",
      "default": "./src/components/alert-dialog-action.tsx"
    },
    "./cancel": {
      "types": "./src/components/alert-dialog-cancel.tsx",
      "import": "./src/components/alert-dialog-cancel.tsx",
      "default": "./src/components/alert-dialog-cancel.tsx"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./preview": {
      "types": "./src/preview.tsx",
      "import": "./src/preview.tsx",
      "default": "./src/preview.tsx"
    },
    "./examples": {
      "types": "./src/examples.tsx",
      "import": "./src/examples.tsx",
      "default": "./src/examples.tsx"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap --noEmit false --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --write"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-beta.3",
    "@patternmode/button": "workspace:*",
    "@patternmode/config": "workspace:*",
    "@patternmode/subheading": "workspace:*",
    "@patternmode/text": "workspace:*",
    "@patternmode/utils": "workspace:*",
    "lucide-react": "^0.543.0",
    "tailwind-variants": "^3.1.1"
  },
  "devDependencies": {
    "@patternmode/tsconfig": "workspace:*"
  }
}
