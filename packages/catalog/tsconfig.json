{
  "extends": "@patternmode/tsconfig/react-library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@patternmode/*/config": ["../*/src/config"],
      "@patternmode/*/preview": ["../*/src/preview"],
      "@patternmode/*/examples": ["../*/src/examples"],
      "@patternmode/config/*": ["../config/src/*"],
      "@patternmode/*": ["../*/src"]
    }
  },
  "include": ["src"]
}
