{
  "extends": "../tsconfig/base.json",
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "@playwright/experimental-ct-react"
    ]
  }
}
