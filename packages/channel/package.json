{
  "name": "@patternmode/channel",
  "version": "0.2.1",
  "private": false,
  "description": "Gradient channel sliders with glass thumbs and Swatch sizing.",
  "keywords": [
    "channel",
    "color",
    "patternmode",
    "react",
    "slider"
  ],
  "homepage": "https://github.com/howells/patternmode/tree/main/packages/channel#readme",
  "bugs": {
    "url": "https://github.com/howells/patternmode/issues"
  },
  "license": "MIT",
  "author": "Daniel Howells",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/howells/patternmode.git",
    "directory": "packages/channel"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "concurrently \"tsdown --watch\" \"tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false --watch --preserveWatchOutput\" \"tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch\"",
    "e2e": "vitest run --config vitest.browser.config.ts",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "prepack": "node ../../scripts/prepack-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@patternmode/swatch": "workspace:*"
  },
  "devDependencies": {
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "concurrently": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
