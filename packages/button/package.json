{
	"name": "@patternmode/button",
	"version": "0.1.0",
	"description": "Interactive button component with multiple variants and states for user actions",
	"author": {
		"name": "Daniel Howells",
		"email": "daniel@howellsstudio.com",
		"url": "https://github.com/howells"
	},
	"type": "module",
	"license": "MIT",
	"homepage": "https://patternmode.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/howells/patternmode.git",
		"directory": "packages/button"
	},
	"bugs": {
		"url": "https://github.com/howells/patternmode/issues"
	},
	"keywords": [
		"react",
		"button",
		"ui",
		"components",
		"tailwind",
		"tailwindcss",
		"typescript",
		"accessibility",
		"a11y",
		"base-ui"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/component.tsx",
			"import": "./src/component.tsx",
			"default": "./src/component.tsx"
		},
		"./component": {
			"types": "./src/component.tsx",
			"import": "./src/component.tsx",
			"default": "./src/component.tsx"
		},
		"./variants": {
			"types": "./src/variants.ts",
			"import": "./src/variants.ts",
			"default": "./src/variants.ts"
		},
		"./types": {
			"types": "./src/types.ts",
			"import": "./src/types.ts",
			"default": "./src/types.ts"
		},
		"./constants": {
			"types": "./src/constants.ts",
			"import": "./src/constants.ts",
			"default": "./src/constants.ts"
		},
		"./utils": {
			"types": "./src/utils.ts",
			"import": "./src/utils.ts",
			"default": "./src/utils.ts"
		},
		"./config": {
			"types": "./src/config.ts",
			"import": "./src/config.ts",
			"default": "./src/config.ts"
		},
		"./preview": {
			"types": "./src/preview.tsx",
			"import": "./src/preview.tsx",
			"default": "./src/preview.tsx"
		},
		"./examples": {
			"types": "./src/examples.tsx",
			"import": "./src/examples.tsx",
			"default": "./src/examples.tsx"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src"
	],
	"engines": {
		"node": ">=18.0.0",
		"npm": ">=8.0.0"
	},
	"scripts": {
		"build": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src --write",
		"test": "timeout 90s vitest run --reporter=basic --testTimeout=30000 --no-watch --passWithNoTests || true",
		"test:e2e": "NODE_ENV=test timeout 180s playwright test --config=playwright-ct.config.ts || true"
	},
	"peerDependencies": {
		"@base-ui-components/react": "^1.0.0-beta.2",
		"lucide-react": ">=0.525.0 <1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@patternmode/config": "workspace:*",
		"@patternmode/utils": "workspace:*",
		"@patternmode/icon": "workspace:*",
		"@patternmode/kbd": "workspace:*",
		"@patternmode/loader": "workspace:*",
		"@patternmode/constants": "workspace:*",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^2.1.0"
	},
	"devDependencies": {
		"@playwright/experimental-ct-react": "^1.55.0",
		"@playwright/test": "^1.55.0",
		"@types/node": "^24.3.0",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}