{
  "name": "@patternmode/verge",
  "version": "0.1.5",
  "private": false,
  "description": "A reserved slot whose controls rest hidden and reveal on hover, focus, or touch — with no layout shift.",
  "keywords": [
    "accessibility",
    "component",
    "focus-within",
    "hover",
    "patternmode",
    "react",
    "row-actions"
  ],
  "homepage": "https://github.com/howells/patternmode/tree/main/packages/verge#readme",
  "bugs": {
    "url": "https://github.com/howells/patternmode/issues"
  },
  "license": "MIT",
  "author": "Daniel Howells",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/howells/patternmode.git",
    "directory": "packages/verge"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "concurrently \"tsdown --watch\" \"tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false --watch --preserveWatchOutput\" \"tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch\"",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "prepack": "node ../../scripts/prepack-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@patternmode/system": "workspace:*"
  },
  "devDependencies": {
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
