{
  "name": "@patternmode/number-field",
  "version": "0.1.0",
  "description": "Numeric input with steppers and scrub-area label",
  "type": "module",
  "license": "MIT",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./component": {
      "types": "./src/component.tsx",
      "import": "./src/component.tsx",
      "default": "./src/component.tsx"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./preview": {
      "types": "./src/preview.tsx",
      "import": "./src/preview.tsx",
      "default": "./src/preview.tsx"
    },
    "./examples": {
      "types": "./src/examples.tsx",
      "import": "./src/examples.tsx",
      "default": "./src/examples.tsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap --noEmit false --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --write"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-beta.3",
    "@patternmode/button": "workspace:*",
    "@patternmode/config": "workspace:*",
    "@patternmode/constants": "workspace:*",
    "@patternmode/input": "workspace:*",
    "@patternmode/utils": "workspace:*",
    "lucide-react": "^0.543.0",
    "tailwind-variants": "^3.1.1"
  },
  "devDependencies": {
    "@patternmode/tsconfig": "workspace:*"
  }
}
