{
	"name": "@patternmode/combobox",
	"version": "0.1.0",
	"description": "Searchable dropdown (combobox) with Downshift, virtualized list, and optional async fetching",
	"author": {
		"name": "Daniel Howells",
		"email": "daniel@howellsstudio.com",
		"url": "https://github.com/howells"
	},
	"type": "module",
	"license": "MIT",
	"homepage": "https://patternmode.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/howells/patternmode.git",
		"directory": "packages/combobox"
	},
	"bugs": {
		"url": "https://github.com/howells/patternmode/issues"
	},
	"sideEffects": false,
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./component": {
			"types": "./src/component.tsx",
			"import": "./src/component.tsx",
			"default": "./src/component.tsx"
		},
		"./types": {
			"types": "./src/types.ts",
			"import": "./src/types.ts",
			"default": "./src/types.ts"
		},
		"./variants": {
			"types": "./src/variants.ts",
			"import": "./src/variants.ts",
			"default": "./src/variants.ts"
		},
		"./config": {
			"types": "./src/config.ts",
			"import": "./src/config.ts",
			"default": "./src/config.ts"
		},
		"./preview": {
			"types": "./src/preview.tsx",
			"import": "./src/preview.tsx",
			"default": "./src/preview.tsx"
		},
		"./examples": {
			"types": "./src/examples.tsx",
			"import": "./src/examples.tsx",
			"default": "./src/examples.tsx"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src"
	],
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"build": "tsc --noEmit",
		"types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap --noEmit false --outDir dist",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src --write"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"lucide-react": ">=0.525.0 <1"
	},
	"dependencies": {
		"@patternmode/config": "workspace:*",
		"@patternmode/utils": "workspace:*",
		"@patternmode/icon": "workspace:*",
		"@patternmode/loader": "workspace:*",
		"@patternmode/select": "workspace:*",
		"@tanstack/react-query": "^5.85.5",
		"@tanstack/react-virtual": "^3.13.12",
		"downshift": "^9.0.10",
		"tailwind-variants": "^2.1.0"
	},
	"devDependencies": {
		"@patternmode/tsconfig": "workspace:*",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
