{
  "name": "@patternmode/tag",
  "version": "0.1.0",
  "description": "Label component for categorizing and tagging content with removable options",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./component": {
      "types": "./src/components/tag.tsx",
      "import": "./src/components/tag.tsx",
      "default": "./src/components/tag.tsx"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./preview": {
      "types": "./src/preview.tsx",
      "import": "./src/preview.tsx",
      "default": "./src/preview.tsx"
    },
    "./examples": {
      "types": "./src/examples.tsx",
      "import": "./src/examples.tsx",
      "default": "./src/examples.tsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --write"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-beta.3",
    "@patternmode/avatar": "workspace:*",
    "@patternmode/config": "workspace:*",
    "@patternmode/constants": "workspace:*",
    "@patternmode/dismiss-button": "workspace:*",
    "@patternmode/icon": "workspace:*",
    "@patternmode/utils": "workspace:*",
    "lucide-react": "^0.544.0"
  }
}
