{
  "name": "@patternmode/sidebar",
  "version": "0.1.0",
  "description": "Minimal sidebar component with state management for PatternMode applications",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./preview": {
      "types": "./src/preview.tsx",
      "import": "./src/preview.tsx",
      "default": "./src/preview.tsx"
    },
    "./examples": {
      "types": "./src/examples.tsx",
      "import": "./src/examples.tsx",
      "default": "./src/examples.tsx"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --write"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-beta.3",
    "@patternmode/button": "workspace:*",
    "@patternmode/config": "workspace:*",
    "@patternmode/separator": "workspace:*",
    "@patternmode/tooltip": "workspace:*",
    "@patternmode/utils": "workspace:*",
    "@react-aria/interactions": "^3.25.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
