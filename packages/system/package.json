{
  "name": "@patternmode/system",
  "version": "0.2.3",
  "private": false,
  "description": "Shared Patternmode sizing, responsive, object sizing, and composition utilities.",
  "keywords": [
    "design-system",
    "object-fit",
    "patternmode",
    "responsive",
    "sizing"
  ],
  "homepage": "https://github.com/howells/patternmode/tree/main/packages/system#readme",
  "bugs": {
    "url": "https://github.com/howells/patternmode/issues"
  },
  "license": "MIT",
  "author": "Daniel Howells",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/howells/patternmode.git",
    "directory": "packages/system"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false",
    "clean": "rm -rf dist .turbo",
    "dev": "concurrently \"pnpm dev:js\" \"pnpm dev:types\"",
    "dev:js": "tsdown --watch",
    "dev:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false --watch --preserveWatchOutput",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "concurrently": "^9.2.1",
    "tsdown": "^0.22.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
