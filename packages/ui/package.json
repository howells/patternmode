{
	"name": "@patternmode/ui",
	"version": "0.1.2",
	"description": "A comprehensive UI component library built with React, Tailwind CSS, and Base UI. Features accessible, customizable components with TypeScript support, modern design patterns, and excellent developer experience.",
	"author": {
		"name": "Daniel Howells",
		"email": "daniel@howellsstudio.com",
		"url": "https://github.com/howells"
	},
	"type": "module",
	"license": "MIT",
	"homepage": "https://patternmode.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/howells/patternmode.git",
		"directory": "packages/ui"
	},
	"bugs": {
		"url": "https://github.com/howells/patternmode/issues"
	},
	"keywords": [
		"react",
		"ui",
		"components",
		"tailwind",
		"tailwindcss",
		"design-system",
		"typescript",
		"accessibility",
		"a11y",
		"base-ui",
		"headless-ui",
		"component-library",
		"react-components",
		"ui-kit",
		"design-tokens",
		"modern-ui",
		"responsive",
		"customizable",
		"open-source"
	],
	"sideEffects": [
		"*.css"
	],
	"exports": {
		"./components/*": {
			"types": "./src/components/*/component.tsx",
			"import": "./src/components/*/component.tsx",
			"default": "./src/components/*/component.tsx"
		},
		"./components/*/variants": {
			"types": "./src/components/*/variants.ts",
			"import": "./src/components/*/variants.ts",
			"default": "./src/components/*/variants.ts"
		},
		"./components/*/types": {
			"types": "./src/components/*/types.ts",
			"import": "./src/components/*/types.ts",
			"default": "./src/components/*/types.ts"
		},
		"./components/*/constants": {
			"types": "./src/components/*/constants.ts",
			"import": "./src/components/*/constants.ts",
			"default": "./src/components/*/constants.ts"
		},
		"./components/registry": {
			"types": "./src/components/registry.ts",
			"import": "./src/components/registry.ts",
			"default": "./src/components/registry.ts"
		},
		"./components/*/config": {
			"types": "./src/components/*/config.ts",
			"import": "./src/components/*/config.ts",
			"default": "./src/components/*/config.ts"
		},
		"./components/*/preview": {
			"types": "./src/components/*/preview.tsx",
			"import": "./src/components/*/preview.tsx",
			"default": "./src/components/*/preview.tsx"
		},
		"./constants/*": {
			"types": "./src/constants/*.ts",
			"import": "./src/constants/*.ts",
			"default": "./src/constants/*.ts"
		},
		"./presentation/*": {
			"types": "./src/presentation/*.ts",
			"import": "./src/presentation/*.ts",
			"default": "./src/presentation/*.ts"
		},
		"./icons/*": {
			"types": "./src/icons/*.ts",
			"import": "./src/icons/*.ts",
			"default": "./src/icons/*.ts"
		},
		"./config/*": {
			"types": "./src/config/*.ts",
			"import": "./src/config/*.ts",
			"default": "./src/config/*.ts"
		},
		"./utils/spacing-utils": {
			"types": "./src/presentation/spacing-utils.ts",
			"import": "./src/presentation/spacing-utils.ts",
			"default": "./src/presentation/spacing-utils.ts"
		},
		"./types/*": {
			"types": "./src/types/*.ts",
			"import": "./src/types/*.ts",
			"default": "./src/types/*.ts"
		},
		"./utils/*": {
			"types": "./src/utils/*.ts",
			"import": "./src/utils/*.ts",
			"default": "./src/utils/*.ts"
		},
		"./utils": {
			"types": "./src/utils.ts",
			"import": "./src/utils.ts",
			"default": "./src/utils.ts"
		},
		"./cx": {
			"types": "./src/cx.ts",
			"import": "./src/cx.ts",
			"default": "./src/cx.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"src"
	],
	"engines": {
		"node": ">=18.0.0",
		"npm": ">=8.0.0"
	},
	"scripts": {
		"build": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src --write",
		"test": "timeout 90s vitest run --reporter=basic --testTimeout=30000 --no-watch --passWithNoTests || true",
		"test:e2e": "NODE_ENV=test timeout 180s playwright test --config=playwright-ct.config.ts || true",
		"generate:registry": "node scripts/generate-registry.cjs",
		"prepublishOnly": "npm run typecheck && npm run test",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@base-ui-components/react": "^1.0.0-beta.2",
		"@tanstack/react-query": "^5.84.1",
		"lucide-react": ">=0.525.0 <1",
		"motion": "^12.23.12",
		"next": "^14.0.0 || ^15.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"recharts": "^3.1.0",
		"zod": ">=3.25.0 <5"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-query": {
			"optional": true
		},
		"next": {
			"optional": true
		},
		"recharts": {
			"optional": true
		}
	},
  "dependencies": {
		"@patternmode/button": "workspace:*",
		"@patternmode/config": "workspace:*",
		"@patternmode/utils": "workspace:*",
		"@patternmode/icons": "workspace:*",
		"@patternmode/icon": "workspace:*",
		"@patternmode/kbd": "workspace:*",
		"@patternmode/loader": "workspace:*",
		"@patternmode/constants": "workspace:*",
    "@patternmode/stack": "workspace:*",
    "@patternmode/grid": "workspace:*",
    "@patternmode/text": "workspace:*",
    "@patternmode/tooltip": "workspace:*",
    "@patternmode/separator": "workspace:*",
    "@patternmode/heading": "workspace:*",
    "@patternmode/subheading": "workspace:*",
    "@patternmode/label": "workspace:*",
    "@patternmode/icon-container": "workspace:*",
    "@patternmode/badge": "workspace:*",
    "@patternmode/dot": "workspace:*",
    "@patternmode/dismiss-button": "workspace:*",
    "@patternmode/avatar": "workspace:*",
    "@patternmode/tag": "workspace:*",
    "@patternmode/tag-group": "workspace:*",
    "@patternmode/dropdown-item": "workspace:*",
    "@patternmode/tag-input": "workspace:*",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@internationalized/date": "^3.8.2",
		"@react-aria/datepicker": "^3.15.0",
		"@react-stately/datepicker": "^3.15.0",
		"@t3-oss/env-core": "^0.13.8",
		"@tanstack/react-virtual": "^3.13.12",
		"@uidotdev/usehooks": "^2.4.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"downshift": "^9.0.10",
		"embla-carousel-react": "^8.6.0",
		"react-day-picker": "^9.9.0",
		"react-syntax-highlighter": "^15.6.1",
		"react-textarea-autosize": "^8.5.9",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^2.1.0",
		"tailwindcss": "^4.1.12",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@playwright/experimental-ct-react": "^1.55.0",
		"@playwright/test": "^1.55.0",
		"@tailwindcss/postcss": "^4.1.12",
		"@types/node": "^24.3.0",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^5.0.1",
		"@vitest/ui": "^3.2.4",
		"jsdom": "^26.1.0",
		"playwright": "^1.55.0",
		"postcss": "^8.5.6",
		"react-docgen-typescript": "^2.4.0",
		"typescript": "^5.9.2",
		"vite": "^7.1.3",
		"vitest": "^3.2.4"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
