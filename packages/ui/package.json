{
  "name": "@patternmode/ui",
  "version": "0.1.0",
  "description": "A comprehensive UI component library built with React, Tailwind CSS, and Base UI",
  "author": "Daniel Howells",
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "design-system",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./*": {
      "types": "./src/components/*/index.tsx",
      "import": "./src/components/*/index.tsx",
      "require": "./src/components/*/index.tsx"
    },
    "./components/*/examples": {
      "types": "./src/components/*/examples.tsx",
      "import": "./src/components/*/examples.tsx",
      "require": "./src/components/*/examples.tsx"
    },
    "./components/*/preview": {
      "types": "./src/components/*/preview.tsx",
      "import": "./src/components/*/preview.tsx",
      "require": "./src/components/*/preview.tsx"
    },
    "./registry": {
      "types": "./src/components/registry.ts",
      "import": "./src/components/registry.ts",
      "require": "./src/components/registry.ts"
    },
    "./components/registry": {
      "types": "./src/components/registry.ts",
      "import": "./src/components/registry.ts",
      "require": "./src/components/registry.ts"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "validate-examples": "npx tsx scripts/validate-examples.ts",
    "extract-props": "tsx scripts/extract-props.ts",
    "generate-icon-list": "tsx scripts/generate-icon-list.ts"
  },
  "peerDependencies": {
    "@base-ui-components/react": "^1.0.0-beta.2",
    "@tanstack/react-query": "^5.84.1",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.12",
    "next": "^14.0.0 || ^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.1.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@internationalized/date": "^3.8.2",
    "@react-aria/datepicker": "^3.15.0",
    "@react-stately/datepicker": "^3.15.0",
    "@t3-oss/env-core": "^0.13.8",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "downshift": "^9.0.10",
    "embla-carousel-react": "^8.6.0",
    "fast-deep-equal": "^3.1.3",
    "react-day-picker": "^9.8.1",
    "react-syntax-highlighter": "^15.6.1",
    "react-textarea-autosize": "^8.5.9",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^2.1.0",
    "tailwindcss": "^4.1.11",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@patternmode/eslint-config": "workspace:*",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
