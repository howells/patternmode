{
  "name": "@patternmode/ui",
  "version": "0.1.0",
  "description": "A comprehensive UI component library built with React, Tailwind CSS, and Base UI. Features accessible, customizable components with TypeScript support, modern design patterns, and excellent developer experience.",
  "author": {
    "name": "Daniel Howells",
    "email": "daniel@patternmode.com",
    "url": "https://github.com/danielhowells"
  },
  "type": "module",
  "license": "MIT",
  "homepage": "https://patternmode.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/patternmode/patternmode.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/patternmode/patternmode/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "tailwindcss",
    "design-system",
    "typescript",
    "accessibility",
    "a11y",
    "base-ui",
    "headless-ui",
    "component-library",
    "react-components",
    "ui-kit",
    "design-tokens",
    "modern-ui",
    "responsive",
    "customizable",
    "open-source"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./components/*": {
      "types": "./src/components/*/index.tsx",
      "import": "./src/components/*/index.tsx",
      "default": "./src/components/*/index.tsx"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "import": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "validate-examples": "npx tsx scripts/validate-examples.ts",
    "extract-props": "tsx scripts/extract-props.ts",
    "generate-icon-list": "tsx scripts/generate-icon-list.ts",
    "prepublishOnly": "npm run typecheck && npm run test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@base-ui-components/react": "^1.0.0-beta.2",
    "@tanstack/react-query": "^5.84.1",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.12",
    "next": "^14.0.0 || ^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.1.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@internationalized/date": "^3.8.2",
    "@react-aria/datepicker": "^3.15.0",
    "@react-stately/datepicker": "^3.15.0",
    "@t3-oss/env-core": "^0.13.8",
    "@tanstack/react-virtual": "^3.13.12",
    "@uidotdev/usehooks": "^2.4.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "downshift": "^9.0.10",
    "embla-carousel-react": "^8.6.0",
    "fast-deep-equal": "^3.1.3",
    "react-day-picker": "^9.8.1",
    "react-syntax-highlighter": "^15.6.1",
    "react-textarea-autosize": "^8.5.9",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^2.1.0",
    "tailwindcss": "^4.1.11",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@patternmode/eslint-config": "workspace:*",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
