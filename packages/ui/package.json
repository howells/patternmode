{
  "name": "@patternmode/ui",
  "version": "0.1.0",
  "description": "A comprehensive UI component library built with React, Tailwind CSS, and Base UI",
  "author": "Daniel Howells",
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "design-system",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./components/*/examples": {
      "types": "./src/components/*/examples.tsx",
      "import": "./src/components/*/examples.tsx",
      "require": "./src/components/*/examples.tsx"
    },
    "./components/*/preview": {
      "types": "./src/components/*/preview.tsx",
      "import": "./src/components/*/preview.tsx",
      "require": "./src/components/*/preview.tsx"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",

    "validate-examples": "npx tsx scripts/validate-examples.ts",
    "generate-registry": "tsx scripts/generate-component-registry.ts"
  },
  "peerDependencies": {
    "@base-ui-components/react": "^1.0.0-beta.1",
    "@tanstack/react-query": "^5.0.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.525.0",
    "next": "^14.0.0 || ^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.1.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@headlessui/react": "^2.2.5",
    "@internationalized/date": "^3.8.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@react-aria/datepicker": "^3.15.0",
    "@react-stately/datepicker": "^3.15.0",
    "@uidotdev/usehooks": "^2.4.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "4.1.0",
    "downshift": "^9.0.10",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "motion": "^12.23.7",
    "react-day-picker": "9.8.0",
    "react-syntax-highlighter": "15.6.1",
    "react-textarea-autosize": "^8.5.9",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.0.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@patternmode/eslint-config": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9",
    "jsdom": "^26.1.0",
    "react-docgen-typescript": "^2.2.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
