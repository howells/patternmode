{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "type": "registry:theme",
  "title": "Patternmode Theme",
  "description": "The Patternmode design system theme: warm paper light and cool graphite dark tokens, hairline borders, nine type roles, fonts, radii, and shadows.",
  "registryDependencies": [
    "__REGISTRY_BASE_URL__/r/font-inter.json",
    "__REGISTRY_BASE_URL__/r/font-hedvig-letters-serif.json",
    "__REGISTRY_BASE_URL__/r/font-geist-mono.json"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "var(--font-inter, Inter), ui-sans-serif, system-ui, sans-serif",
      "font-serif": "var(--font-hedvig-letters-serif, 'Hedvig Letters Serif'), ui-serif, Georgia, Cambria, 'Times New Roman', serif",
      "font-mono": "var(--font-geist-mono, 'Geist Mono'), ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Monaco, Consolas, monospace",
      "default-border-width": "var(--hairline)",
      "ease-out": "cubic-bezier(0.23, 1, 0.32, 1)",
      "default-transition-duration": "150ms",
      "default-transition-timing-function": "var(--ease-out)"
    },
    "light": {
      "background": "oklch(0.988 0.0026 106)",
      "foreground": "oklch(0.23 0.004 107)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.23 0.004 107)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.23 0.004 107)",
      "primary": "oklch(0.23 0.004 107)",
      "primary-foreground": "oklch(0.988 0.0026 106)",
      "secondary": "oklch(0.97 0.0054 95)",
      "secondary-foreground": "oklch(0.23 0.004 107)",
      "muted": "oklch(0.97 0.0054 95)",
      "muted-foreground": "oklch(0.51 0.0124 95)",
      "accent": "oklch(0.9533 0.0038 95)",
      "accent-foreground": "oklch(0.23 0.004 107)",
      "destructive": "oklch(0.55 0.17 28)",
      "border": "oklch(0.91 0.0071 89)",
      "input": "oklch(0.91 0.0071 89)",
      "ring": "oklch(0.438 0.0563 166.35)",
      "chart-1": "oklch(0.438 0.0563 166.35)",
      "chart-2": "oklch(0.91 0.0071 89)",
      "chart-3": "oklch(0.872 0.008 86)",
      "chart-4": "oklch(0.72 0.14 70)",
      "chart-5": "oklch(0.56 0.12 252)",
      "radius": "0.5rem",
      "sidebar": "oklch(0.97 0.0054 95)",
      "sidebar-foreground": "oklch(0.23 0.004 107)",
      "sidebar-primary": "oklch(0.23 0.004 107)",
      "sidebar-primary-foreground": "oklch(0.988 0.0026 106)",
      "sidebar-accent": "oklch(0.9533 0.0038 95)",
      "sidebar-accent-foreground": "oklch(0.23 0.004 107)",
      "sidebar-border": "oklch(0.91 0.0071 89)",
      "sidebar-ring": "oklch(0.438 0.0563 166.35)",
      "shadow-xs": "0 0 0 var(--hairline) var(--border), 0 1px 2px oklch(0.23 0.004 107 / 0.04)",
      "shadow-sm": "0 0 0 var(--hairline) var(--border), 0 1px 2px oklch(0.23 0.004 107 / 0.06)",
      "shadow-md": "0 0 0 var(--hairline) var(--border), 0 2px 4px -1px oklch(0.23 0.004 107 / 0.06), 0 12px 32px -8px oklch(0.23 0.004 107 / 0.16)",
      "shadow-lg": "0 0 0 var(--hairline) var(--border), 0 12px 32px -8px oklch(0.23 0.004 107 / 0.16)",
      "shadow-xl": "0 0 0 var(--hairline) var(--border), 0 28px 70px oklch(0.23 0.004 107 / 0.14)"
    },
    "dark": {
      "background": "oklch(0.19 0.009 250)",
      "foreground": "oklch(0.91 0.005 250)",
      "card": "oklch(0.225 0.01 250)",
      "card-foreground": "oklch(0.91 0.005 250)",
      "popover": "oklch(0.225 0.01 250)",
      "popover-foreground": "oklch(0.91 0.005 250)",
      "primary": "oklch(0.91 0.005 250)",
      "primary-foreground": "oklch(0.19 0.009 250)",
      "secondary": "oklch(0.255 0.011 250)",
      "secondary-foreground": "oklch(0.91 0.005 250)",
      "muted": "oklch(0.255 0.011 250)",
      "muted-foreground": "oklch(0.68 0.008 250)",
      "accent": "oklch(0.255 0.011 250)",
      "accent-foreground": "oklch(0.91 0.005 250)",
      "destructive": "oklch(0.68 0.16 28)",
      "border": "oklch(0.2935 0.0095 250)",
      "input": "oklch(0.2935 0.0095 250)",
      "ring": "oklch(0.76 0.085 166)",
      "chart-1": "oklch(0.76 0.085 166)",
      "chart-2": "oklch(0.35 0.009 250)",
      "chart-3": "oklch(0.44 0.009 250)",
      "chart-4": "oklch(0.8 0.13 72)",
      "chart-5": "oklch(0.7 0.11 252)",
      "sidebar": "oklch(0.165 0.008 250)",
      "sidebar-foreground": "oklch(0.91 0.005 250)",
      "sidebar-primary": "oklch(0.91 0.005 250)",
      "sidebar-primary-foreground": "oklch(0.165 0.008 250)",
      "sidebar-accent": "oklch(0.225 0.01 250)",
      "sidebar-accent-foreground": "oklch(0.91 0.005 250)",
      "sidebar-border": "oklch(0.2935 0.0095 250)",
      "sidebar-ring": "oklch(0.76 0.085 166)",
      "shadow-xs": "inset 0 var(--hairline) 0 oklch(1 0 0 / 0.035), 0 0 0 var(--hairline) var(--border)",
      "shadow-sm": "inset 0 var(--hairline) 0 oklch(1 0 0 / 0.045), 0 0 0 var(--hairline) var(--border), 0 1px 2px oklch(0 0 0 / 0.3)",
      "shadow-md": "inset 0 var(--hairline) 0 oklch(1 0 0 / 0.06), 0 0 0 var(--hairline) var(--border), 0 12px 32px -8px oklch(0 0 0 / 0.55)",
      "shadow-lg": "inset 0 var(--hairline) 0 oklch(1 0 0 / 0.06), 0 0 0 var(--hairline) var(--border), 0 16px 40px -8px oklch(0 0 0 / 0.55)",
      "shadow-xl": "inset 0 var(--hairline) 0 oklch(1 0 0 / 0.06), 0 0 0 var(--hairline) var(--border), 0 28px 70px oklch(0 0 0 / 0.5)"
    }
  }
}
