{
  "name": "@patternmode/theme",
  "version": "0.1.0",
  "private": true,
  "description": "Patternmode shadcn theme + registry source. Private: distributed via the shadcn registry (apps/web/public/r), never npm.",
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build-registry.mjs",
    "clean": "rm -rf dist .staging .turbo",
    "lint": "howells-check . --no-error-on-unmatched-pattern",
    "lint:fix": "howells-fix . --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@howells/lint": "catalog:",
    "@howells/motion": "workspace:*",
    "@patternmode/aperto": "workspace:*",
    "@patternmode/briolette": "workspace:*",
    "@patternmode/deck": "workspace:*",
    "@patternmode/halo": "workspace:*",
    "@patternmode/parquet": "workspace:*",
    "@patternmode/scrollframe": "workspace:*",
    "@patternmode/stacksheet": "workspace:*",
    "@patternmode/status": "workspace:*",
    "@patternmode/swatch": "workspace:*",
    "@patternmode/system": "workspace:*",
    "@patternmode/tags": "workspace:*",
    "shadcn": "4.13.0"
  }
}
