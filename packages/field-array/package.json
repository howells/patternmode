{
  "name": "@patternmode/field-array",
  "version": "0.1.0",
  "description": "Field array for dynamic repeatable form inputs",
  "type": "module",
  "license": "MIT",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./preview": {
      "types": "./src/preview.tsx",
      "import": "./src/preview.tsx",
      "default": "./src/preview.tsx"
    },
    "./examples": {
      "types": "./src/examples.tsx",
      "import": "./src/examples.tsx",
      "default": "./src/examples.tsx"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap --noEmit false --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --write"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@patternmode/avatar": "workspace:*",
    "@patternmode/button": "workspace:*",
    "@patternmode/checkbox": "workspace:*",
    "@patternmode/config": "workspace:*",
    "@patternmode/description-list": "workspace:*",
    "@patternmode/dismiss-button": "workspace:*",
    "@patternmode/fieldset": "workspace:*",
    "@patternmode/grid": "workspace:*",
    "@patternmode/input": "workspace:*",
    "@patternmode/scroll-area": "workspace:*",
    "@patternmode/select": "workspace:*",
    "@patternmode/stack": "workspace:*",
    "@patternmode/subheading": "workspace:*",
    "@patternmode/textarea": "workspace:*",
    "@patternmode/utils": "workspace:*",
    "lucide-react": "^0.543.0"
  },
  "devDependencies": {
    "@patternmode/tsconfig": "workspace:*"
  }
}
