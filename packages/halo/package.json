{
  "name": "@patternmode/halo",
  "version": "0.1.0",
  "private": false,
  "description": "A round saturation/lightness color picker with a compact hue arc.",
  "keywords": [
    "color",
    "component",
    "halo",
    "hsl",
    "patternmode",
    "react"
  ],
  "homepage": "https://github.com/howells/patternmode/tree/main/packages/halo#readme",
  "bugs": {
    "url": "https://github.com/howells/patternmode/issues"
  },
  "license": "MIT",
  "author": "Daniel Howells",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/howells/patternmode.git",
    "directory": "packages/halo"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false && pnpm build:styles",
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "clean": "rm -rf dist .turbo",
    "dev": "concurrently \"pnpm dev:js\" \"pnpm dev:types\" \"pnpm dev:styles\"",
    "dev:js": "tsdown --watch",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "dev:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false --watch --preserveWatchOutput",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "@tailwindcss/cli": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "^9.2.1",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "^0.22.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
