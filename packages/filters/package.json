{
  "name": "@patternmode/filters",
  "version": "0.1.0",
  "private": false,
  "description": "Composable filter toolbar, search field, sentence filter chips, option pickers, and typed rule editors for React.",
  "keywords": [
    "component",
    "filter",
    "filter-bar",
    "patternmode",
    "react",
    "search",
    "toolbar"
  ],
  "homepage": "https://github.com/howells/patternmode/tree/main/packages/filters#readme",
  "bugs": {
    "url": "https://github.com/howells/patternmode/issues"
  },
  "license": "MIT",
  "author": "Daniel Howells",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/howells/patternmode.git",
    "directory": "packages/filters"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "default": "./dist/state.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "concurrently \"tsdown --watch\" \"tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false --watch --preserveWatchOutput\" \"tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch\"",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "prepack": "node ../../scripts/prepack-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "cn": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "registry": {
    "type": "component",
    "css": "src/styles.css"
  }
}
