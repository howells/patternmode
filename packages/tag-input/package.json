{
  "name": "@patternmode/tag-input",
  "version": "0.1.0",
  "description": "Multi-select Tag Input with search, filtering, and creation (Downshift-based)",
  "author": {
    "name": "Daniel Howells",
    "email": "daniel@howellsstudio.com",
    "url": "https://github.com/howells"
  },
  "type": "module",
  "license": "MIT",
  "homepage": "https://patternmode.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/howells/patternmode.git",
    "directory": "packages/tag-input"
  },
  "bugs": {
    "url": "https://github.com/howells/patternmode/issues"
  },
  "keywords": [
    "react",
    "tag input",
    "multiselect",
    "downshift",
    "ui",
    "components",
    "typescript"
  ],
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./component": {
      "types": "./src/components/tag-input.tsx",
      "import": "./src/components/tag-input.tsx",
      "default": "./src/components/tag-input.tsx"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./preview": {
      "types": "./src/preview.tsx",
      "import": "./src/preview.tsx",
      "default": "./src/preview.tsx"
    },
    "./examples": {
      "types": "./src/examples.tsx",
      "import": "./src/examples.tsx",
      "default": "./src/examples.tsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap --noEmit false --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --write",
    "test": "timeout 90s vitest run --reporter=basic --testTimeout=30000 --no-watch --passWithNoTests || true",
    "test:e2e": "NODE_ENV=test timeout 180s playwright test --config=playwright-ct.config.ts || true"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-beta.3",
    "@patternmode/config": "workspace:*",
    "@patternmode/constants": "workspace:*",
    "@patternmode/icon": "workspace:*",
    "@patternmode/input": "workspace:*",
    "@patternmode/stack": "workspace:*",
    "@patternmode/tag": "workspace:*",
    "@patternmode/utils": "workspace:*",
    "downshift": "^9.0.10",
    "lucide-react": "^0.544.0"
  },
  "devDependencies": {
    "@patternmode/tsconfig": "workspace:*",
    "@playwright/experimental-ct-react": "^1.55.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
