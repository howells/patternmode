{
  "name": "@patternmode/tooltip",
  "version": "0.1.0",
  "description": "Accessible tooltip component built on Base UI with Tailwind variants",
  "author": {
    "name": "Daniel Howells",
    "email": "daniel@howellsstudio.com",
    "url": "https://github.com/howells"
  },
  "type": "module",
  "license": "MIT",
  "homepage": "https://patternmode.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/howells/patternmode.git",
    "directory": "packages/tooltip"
  },
  "bugs": {
    "url": "https://github.com/howells/patternmode/issues"
  },
  "keywords": [
    "react",
    "tooltip",
    "ui",
    "components",
    "tailwind",
    "tailwindcss",
    "typescript",
    "accessibility",
    "a11y",
    "base-ui"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./component": {
      "types": "./src/components/tooltip.tsx",
      "import": "./src/components/tooltip.tsx",
      "default": "./src/components/tooltip.tsx"
    },
    "./root": {
      "types": "./src/components/tooltip-root.tsx",
      "import": "./src/components/tooltip-root.tsx",
      "default": "./src/components/tooltip-root.tsx"
    },
    "./trigger": {
      "types": "./src/components/tooltip-trigger.tsx",
      "import": "./src/components/tooltip-trigger.tsx",
      "default": "./src/components/tooltip-trigger.tsx"
    },
    "./portal": {
      "types": "./src/components/tooltip-portal.tsx",
      "import": "./src/components/tooltip-portal.tsx",
      "default": "./src/components/tooltip-portal.tsx"
    },
    "./positioner": {
      "types": "./src/components/tooltip-positioner.tsx",
      "import": "./src/components/tooltip-positioner.tsx",
      "default": "./src/components/tooltip-positioner.tsx"
    },
    "./popup": {
      "types": "./src/components/tooltip-popup.tsx",
      "import": "./src/components/tooltip-popup.tsx",
      "default": "./src/components/tooltip-popup.tsx"
    },
    "./arrow": {
      "types": "./src/components/tooltip-arrow.tsx",
      "import": "./src/components/tooltip-arrow.tsx",
      "default": "./src/components/tooltip-arrow.tsx"
    },
    "./variants": {
      "types": "./src/variants.ts",
      "import": "./src/variants.ts",
      "default": "./src/variants.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./preview": {
      "types": "./src/preview.tsx",
      "import": "./src/preview.tsx",
      "default": "./src/preview.tsx"
    },
    "./examples": {
      "types": "./src/examples.tsx",
      "import": "./src/examples.tsx",
      "default": "./src/examples.tsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --write",
    "test": "timeout 90s vitest run --reporter=basic --testTimeout=30000 --no-watch --passWithNoTests || true",
    "test:e2e": "NODE_ENV=test timeout 180s playwright test --config=playwright-ct.config.ts || true"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-beta.3",
    "@patternmode/button": "workspace:*",
    "@patternmode/config": "workspace:*",
    "@patternmode/utils": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.543.0",
    "tailwind-variants": "^3.1.1"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1.55.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
