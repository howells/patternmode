{
  "name": "@howells/motion",
  "version": "0.2.1",
  "private": false,
  "description": "Shared motion tokens — springs, easings, durations, scales, and semantic presets for Patternmode interfaces.",
  "keywords": [
    "animation",
    "duration",
    "easing",
    "motion",
    "patternmode",
    "spring",
    "tokens"
  ],
  "homepage": "https://github.com/howells/patternmode/tree/main/packages/motion#readme",
  "bugs": {
    "url": "https://github.com/howells/patternmode/issues"
  },
  "license": "MIT",
  "author": "Daniel Howells",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/howells/patternmode.git",
    "directory": "packages/motion"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false",
    "dev": "concurrently \"tsdown --watch\" \"tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --noEmit false --watch --preserveWatchOutput\"",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "prepack": "node ../../scripts/prepack-build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "concurrently": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
