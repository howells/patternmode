{
  "name": "@patternmode/input-card",
  "version": "0.1.0",
  "description": "Generic input card component",
  "type": "module",
  "license": "MIT",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap --noEmit false --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --write"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@patternmode/card": "workspace:*",
    "@patternmode/utils": "workspace:*"
  },
  "devDependencies": {
    "@patternmode/tsconfig": "workspace:*"
  }
}
