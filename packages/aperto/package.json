{
  "name": "@patternmode/aperto",
  "version": "3.0.0",
  "description": "Opinionated, styled thumbnail-to-expanded media transitions for React.",
  "homepage": "https://github.com/howells/patternmode/tree/main/packages/aperto#readme",
  "bugs": {
    "url": "https://github.com/howells/patternmode/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/howells/patternmode.git",
    "directory": "packages/aperto"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tailwindcss -i styles.css -o dist/styles.css --minify",
    "clean": "rm -rf dist .turbo",
    "dev": "concurrently \"pnpm dev:js\" \"pnpm dev:styles\"",
    "dev:js": "tsup --watch",
    "dev:styles": "tailwindcss -i styles.css -o dist/styles.css --watch",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "prepack": "node ../../scripts/prepack-build.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@howells/motion": "workspace:*"
  },
  "devDependencies": {
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "@tailwindcss/cli": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "^9.2.1",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
