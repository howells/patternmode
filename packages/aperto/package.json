{
	"name": "@patternmode/aperto",
	"version": "0.1.1",
	"description": "Opinionated, styled thumbnail-to-expanded media transitions for React.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/howells/patternmode.git",
		"directory": "packages/aperto"
	},
	"bugs": {
		"url": "https://github.com/howells/patternmode/issues"
	},
	"homepage": "https://github.com/howells/patternmode/tree/main/packages/aperto#readme",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup && tailwindcss -i styles.css -o dist/styles.css --minify",
		"clean": "rm -rf dist .turbo",
		"dev": "concurrently \"pnpm dev:js\" \"pnpm dev:styles\"",
		"dev:js": "tsup --watch",
		"dev:styles": "tailwindcss -i styles.css -o dist/styles.css --watch",
		"lint": "howells-biome check src",
		"lint:check": "howells-biome check src",
		"prepack": "pnpm build",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.15",
		"lucide-react": "^1.16.0",
		"motion": "^12.38.0"
	},
	"devDependencies": {
		"@howells/typescript-config": "^0.1.2",
		"@tailwindcss/cli": "^4.3.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"concurrently": "^9.2.1",
		"jsdom": "^29.1.1",
		"tailwindcss": "^4.3.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^4.0.15"
	},
	"peerDependencies": {
		"react": ">=18.2.0 <20",
		"react-dom": ">=18.2.0 <20"
	}
}
