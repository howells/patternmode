{
  "name": "@patternmode/aperto",
  "version": "0.2.0",
  "description": "Opinionated, styled thumbnail-to-expanded media transitions for React.",
  "homepage": "https://github.com/howells/patternmode/tree/main/packages/aperto#readme",
  "bugs": {
    "url": "https://github.com/howells/patternmode/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/howells/patternmode.git",
    "directory": "packages/aperto"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tailwindcss -i styles.css -o dist/styles.css --minify",
    "clean": "rm -rf dist .turbo",
    "dev": "concurrently \"pnpm dev:js\" \"pnpm dev:styles\"",
    "dev:js": "tsup --watch",
    "dev:styles": "tailwindcss -i styles.css -o dist/styles.css --watch",
    "lint": "howells-ox-check .",
    "lint:fix": "howells-ox-fix .",
    "prepack": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "lucide-react": "^1.16.0",
    "motion": "^12.38.0"
  },
  "devDependencies": {
    "@howells/lint": "^0.2.1",
    "@howells/typescript-config": "^0.1.2",
    "@tailwindcss/cli": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
