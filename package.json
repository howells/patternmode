{
  "name": "patternmode",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:boundaries && pnpm check:tokens",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "clean": "turbo run clean --continue=always && turbo clean",
    "dev": "pnpm --filter @howells/patternmode-web dev",
    "env:check": "envy check local --schema ./scripts/release-env/schema.mjs --from .env.local",
    "format": "howells-fix .",
    "lint": "turbo run lint && howells-check scripts oxlint.config.ts oxfmt.config.ts *.md docs && howells-workspace-check",
    "lint:fix": "turbo run lint:fix && howells-fix scripts oxlint.config.ts oxfmt.config.ts *.md docs && howells-workspace-fix",
    "prepare": "howells-husky",
    "publish:packages": "node scripts/publish-packages.mjs",
    "smoke:tarballs": "node scripts/smoke-tarballs.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@howells/envy": "catalog:",
    "@howells/husky": "catalog:",
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "lint-staged": "catalog:",
    "postcss": "^8.5.6",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "yaml": "^2.8.0",
    "zod": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css,md}": "node scripts/lint-staged-fix.mjs"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@11.5.2"
}
