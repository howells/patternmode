{
  "name": "patternmode",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "A comprehensive UI component library and design system",
  "author": "Daniel Howells",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:ui": "turbo test:ui",
    "test:run": "turbo test:run",
    "test:e2e": "turbo test:e2e",
    "test:generate": "turbo test:generate",
    "test:all": "turbo test:run && turbo test:e2e",
    "clean": "turbo clean",
    "knip": "knip --no-progress",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "glob": "^11.0.0",
    "knip": "^5.62.0",
    "turbo": "^2.5.5"
  },
  "dependencies": {
    "es-toolkit": "^1.39.8",
    "nuqs": "^2.4.3"
  }
}
