{
	"name": "patternmode",
	"private": true,
	"packageManager": "pnpm@10.23.0",
	"scripts": {
		"build": "turbo run build",
		"check": "pnpm typecheck && pnpm lint:check && pnpm test && pnpm build && pnpm check:boundaries",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"clean": "turbo run clean --continue=always && turbo clean",
		"dev": "turbo run dev --filter=@howells/patternmode-web",
		"format": "howells-format",
		"lint": "pnpm lint:check",
		"lint:check": "turbo run lint:check",
		"prepare": "howells-husky",
		"smoke:tarballs": "node scripts/smoke-tarballs.mjs",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"version-packages": "changeset version"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.7",
		"@howells/husky": "^0.1.0",
		"@howells/lint": "^0.1.7",
		"@howells/typescript-config": "^0.1.2",
		"turbo": "2.9.14",
		"typescript": "^6.0.3"
	},
	"pnpm": {
		"overrides": {
			"postcss": "^8.5.15"
		}
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json,jsonc}": "howells-format"
	}
}
