{
  "name": "patternmode",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "turbo run dev --filter=@patternmode/playground",
    "dev:all": "turbo run dev --parallel",
    "dev:playground": "pnpm --filter @patternmode/playground dev",
    "dev:storybook": "pnpm --filter @patternmode/storybook dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "howells-biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:affected": "turbo run build lint typecheck test --affected",
    "clean": "turbo run clean --continue=always && turbo clean",
    "ui:add": "pnpm dlx shadcn@latest add",
    "prepare": "howells-husky"
  },
  "devDependencies": {
    "@howells/lint": "^0.1.3",
    "@howells/typescript-config": "^0.1.0",
    "@howells/husky": "^0.1.0",
    "turbo": "2.9.3",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css}": "howells-format"
  }
}
