{
  "name": "patternmode",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "description": "A comprehensive UI component library and design system",
  "author": "Daniel Howells",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:ui": "turbo test:ui",
    "test:run": "turbo test:run",
    "test:e2e": "turbo test:e2e",
    "test:generate": "turbo test:generate",
    "test:all": "turbo test:run && turbo test:e2e",
    "clean": "turbo clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.0.0",
    "@changesets/cli": "^2.27.1",
    "@eslint-react/eslint-plugin": "^1.21.0",
    "@eslint/eslintrc": "^3",
    "@next/eslint-plugin-next": "^15.1.0",
    "@patternmode/eslint-config": "workspace:*",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-config-turbo": "^2.3.3",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-jsdoc": "^50.6.1",
    "eslint-plugin-perfectionist": "^4.2.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-turbo": "^2.3.3",
    "knip": "^5.62.0",
    "playwright": "^1.54.1",
    "react-docgen-typescript": "^2.2.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
