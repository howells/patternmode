{
  "name": "patternmode",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @howells/patternmode-web dev",
    "e2e": "turbo run e2e --filter=./packages/*",
    "e2e:consumer": "node scripts/e2e-consumer-install.mjs",
    "lint": "turbo run lint && howells-check scripts oxlint.config.ts oxfmt.config.ts *.md docs && howells-workspace-check",
    "lint:fix": "turbo run lint:fix && howells-fix scripts oxlint.config.ts oxfmt.config.ts *.md docs && howells-workspace-fix",
    "prepare": "howells-husky",
    "prepush": "pnpm typecheck && pnpm lint",
    "release": "node scripts/release.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@howells/envy": "catalog:",
    "@howells/husky": "catalog:",
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "postcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css,md,mdx}": "howells-oxfmt --write"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.3.4"
}
