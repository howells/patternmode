{
  "$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
  "extends": ["ultracite"],
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off"
      },
      "style": {
        "noNestedTernary": "off",
        "noMagicNumbers": "off",
        "useBlockStatements": "off",
        "noNonNullAssertion": "off",
        "noExportedImports": "off"
      },
      "nursery": {
        "useMaxParams": "off"
      }
    }
  }
}
