{
  "prettier.enable": false,
  "editor.formatOnSave": true,
  "editor.formatOnType": false,
  "editor.formatOnPaste": true,
  "intelephense.environment.phpVersion": "8.3",
  "terminal.integrated.env.osx": {},
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.exclude": {
    "**/dist": true,
    "**/*.js": {
      "when": "$(basename).ts"
    },
    "**/*.js.map": true,
    "**/*.d.ts": {
      "when": "$(basename).ts"
    }
  },
  "workbench.editor.customLabels.patterns": {
    "**/app/**/page.tsx": "${dirname} [Page]",
    "**/app/**/layout.tsx": "${dirname} [Layout]",
    "**/components/**/component.tsx": "${dirname} [Component]",
    "**/components/**/examples.tsx": "${dirname} [Examples]",
    "**/components/**/preview.tsx": "${dirname} [Preview]",
    "**/components/**/config.ts": "${dirname} [Config]",
    "**/components/**/types.ts": "${dirname} [Types]",
    "**/components/**/variants.ts": "${dirname} [Variants]",
    "**/components/**/constants.ts": "${dirname} [Constants]",
    "**/components/**/*.stories.tsx": "${dirname} [Stories]",
    "**/components/**/*.playwright.test.tsx": "${dirname} [Test]"
  },
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.updateImportsOnFileMove.enabled": "never",
  "typescript.suggest.autoImports": false,
  "typescript.suggest.paths": false,
  "typescript.preferences.includeCompletionsForModuleExports": false,
  "typescript.preferences.includeCompletionsWithSnippetText": false,
  "typescript.suggest.completeFunctionCalls": true,
  "typescript.referencesCodeLens.enabled": true,
  "typescript.implementationsCodeLens.enabled": true,
  "typescript.surveys.enabled": false,
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.validate.enable": true,
  "typescript.format.enable": false,
  "typescript.format.placeOpenBraceOnNewLineForFunctions": false,
  "typescript.format.placeOpenBraceOnNewLineForControlBlocks": false,
  "typescript.format.insertSpaceAfterCommaDelimiter": false,
  "typescript.format.insertSpaceAfterSemicolonInForStatements": false,
  "typescript.format.insertSpaceBeforeAndAfterBinaryOperators": false,
  "typescript.format.insertSpaceAfterConstructor": false,
  "typescript.format.insertSpaceAfterKeywordsInControlFlowStatements": false,
  "typescript.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false,
  "typescript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyParenthesis": false,
  "typescript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBrackets": false,
  "typescript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": false,
  "typescript.format.insertSpaceAfterOpeningAndBeforeClosingTemplateStringBraces": false,
  "typescript.format.insertSpaceAfterOpeningAndBeforeClosingJsxExpressionBraces": false,
  "typescript.format.insertSpaceAfterTypeAssertion": false,
  "typescript.format.insertSpaceBeforeFunctionParenthesis": false,
  "problems.decorations.enabled": true,
  "explorer.decorations.colors": true,
  "explorer.decorations.badges": true,
  "problems.showCurrentInStatus": true,
  "editor.defaultColorDecorators": "auto",
  "workbench.colorCustomizations": {
    "editorError.foreground": "#ff5050",
    "editorWarning.foreground": "#ffbe33",
    "editorInfo.foreground": "#33adff"
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never",
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "sortImports.on-save": false,
  "typescriptHero.imports.organizeOnSave": false,
  "autoimport.autoComplete": false,
  "typescript-hero.imports.organizeOnSave": false,
  "typescript.suggest.organizeImports": false,
  "editor.codeActionsOnSaveTimeout": 3000,
  "blocksort.enable": false,
  "vscode-scss-formatter.enable": false,
  "cursor.formatOnSave": false,
  "cursor.quickFix.enable": false,
  "cursor.autoFormat": false,
  "cursor.codeActions.organizeImports": false,
  "cursor.typescript.format": false,
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "next.typescript.plugin.enable": false,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "invalid",
        "settings": {
          "foreground": "#ff5050",
          "fontStyle": "underline"
        }
      }
    ]
  },
  "editor.renderLineHighlight": "all",
  "editor.matchBrackets": "always",
  "editor.renderWhitespace": "boundary",
  "cSpell.words": ["patternmode"],
  "vitest.enable": true,
  "vitest.commandLine": "pnpm test",
  "vitest.include": ["**/*.{test,spec}.{js,ts,jsx,tsx}"],
  "playwright.include": [
    "**/*.playwright.test.{js,ts,jsx,tsx}",
    "packages/ui/src/components/**/*.playwright.test.{ts,tsx}",
    "apps/web/tests/**/*.playwright.test.{ts,tsx}"
  ],
  "vitest.exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/e2e/**"
  ],
  "vitest.root": ".",
  "testing.automaticallyOpenPeekView": "never",
  "testing.followRunningTest": true,
  "testing.gutterEnabled": true,
  "testing.openTesting": "openOnTestStart",
  "testing.autoRun.delay": 1000,
  "testing.autoRun.mode": "test-src-file",
  "testing.autoDiscover": true,
  "testing.testExplorer.addToEditorContextMenu": true,
  "testing.testExplorer.gutterDecoration": true,
  "testing.testExplorer.onReload": "retire",
  "testing.testExplorer.onStart": "reset",
  "playwright.env": {
    "NODE_ENV": "test"
  },
  "playwright.reuseBrowser": true,
  "playwright.showTrace": false,
  "testing.automaticallyOpenTestResults": "openOnTestStart",
  "testing.testConfigurations": [
    {
      "name": "UI Components (Playwright CT)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/playwright",
      "args": ["test", "--config=playwright-ct.config.ts"],
      "cwd": "${workspaceFolder}/packages/ui",
      "env": {
        "NODE_ENV": "test"
      }
    },
    {
      "name": "Web App (Playwright)",
      "type": "playwright",
      "configFile": "apps/web/playwright.config.ts",
      "cwd": "apps/web"
    },
    {
      "name": "UI Components (Vitest)",
      "type": "vitest",
      "configFile": "packages/ui/vitest.config.ts",
      "cwd": "packages/ui"
    }
  ],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[graphql]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "emmet.showExpandedAbbreviation": "never"
}
